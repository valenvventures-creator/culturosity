{
  "name": "culturosity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Culturosity \u2014 curated perks, company affinity programs, and managed program services.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch --env-file-if-exists=.env server/node.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "start:api": "tsx --env-file-if-exists=.env server/node.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env scripts/seed.ts --demo",
    "db:reset:local": "tsx --env-file-if-exists=.env scripts/reset-local.ts",
    "gate:init": "tsx --env-file-if-exists=.env scripts/gate.ts init",
    "gate:rotate": "tsx --env-file-if-exists=.env scripts/gate.ts rotate",
    "admin:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "netlify:build": "tsx scripts/netlify-prebuild.ts && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@hono/node-server": "2.1.9",
    "@netlify/blobs": "10.7.13",
    "@tanstack/react-query": "5.90.2",
    "hono": "4.13.19",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.11",
    "@netlify/functions": "4.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
