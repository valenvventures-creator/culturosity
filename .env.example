# =====================================================================
# Culturosity environment configuration
# Copy to `.env` for local work. Never commit real values.
# Everything here is SERVER-ONLY unless the name starts with VITE_.
# =====================================================================

# ---- Mode -------------------------------------------------------------
# "demo"       local/isolated demo: embedded PGlite database in ./.data, demo sign-in personas
# "production" requires DATABASE_URL; demo shortcuts and the dev mailbox are disabled
APP_MODE=demo
APP_BASE_URL=http://localhost:5173

# ---- Database (server-only) -------------------------------------------
# Hosted PostgreSQL connection string (Netlify DB/Neon, Supabase pooled URL, RDS...).
# Leave empty locally to use the embedded PGlite demo database at PGLITE_DIR.
DATABASE_URL=
DATABASE_POOL_MAX=3
PGLITE_DIR=.data/pglite

# ---- Internal numerical gate (server-only, used only by seed/gate scripts) --
# The requested initial code is documented in README.md. Set it here locally,
# run `npm run gate:init`, then you may remove it. It is hashed before storage.
GATE_INITIAL_CODE=
GATE_IDLE_MINUTES=30
GATE_ABSOLUTE_MINUTES=240

# ---- Bootstrap super admin (server-only, used by `npm run admin:bootstrap`) --
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Demo seed (local only) -------------------------------------------
SEED_DEMO_PASSWORD=

# ---- Media storage (server-only) --------------------------------------
# "local"  -> ./.data/uploads (demo only)
# "netlify-blobs" -> Netlify Blobs store (automatic credentials inside Netlify functions)
STORAGE_DRIVER=local
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_BYTES=5242880

# ---- Email (optional, server-only) ------------------------------------
# Without a provider, emails are written to the email_outbox table (dev mailbox in demo mode).
EMAIL_FROM="Culturosity <hello@culturosity.io>"
RESEND_API_KEY=

# ---- AI outreach drafts (optional, server-only) ------------------------
# Without a key, outreach uses clearly labelled example templates.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# ---- Live research search connector (optional, server-only) -----------
# Not configured by default. See docs/RESEARCH.md for the adapter contract.
RESEARCH_SEARCH_PROVIDER=
RESEARCH_SEARCH_API_KEY=

# ---- Public client configuration (bundled into the browser) -----------
VITE_PUBLIC_SITE_NAME=Culturosity
